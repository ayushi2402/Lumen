# ---------------------------------------------------------------------------
# Secrets & environment
# ---------------------------------------------------------------------------
.env
.env.*
# Templates must stay tracked: a fresh clone needs them, and they contain
# placeholders only. This covers .env.example and frontend/.env.local.example.
!.env.example
!**/*.env.example
!**/.env*.example
*.pem
*.key
secrets/
# Upstox tokens are short-lived but are still credentials. Never commit them.
*token*.json

