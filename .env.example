# ===========================================================================
# LUMEN - example environment configuration
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in real values locally.
#   cp .env.example .env
# `.env` is gitignored. NEVER commit real credentials.
# Every value below is an empty placeholder on purpose.
# ===========================================================================

# ---------------------------------------------------------------------------
# Market data - Upstox
# ---------------------------------------------------------------------------
# Created in the Upstox developer console. The redirect URI must match the
# value registered there exactly, including scheme and port.
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
UPSTOX_REDIRECT_URI=

# Obtained via the Upstox OAuth flow.
# NOTE: Upstox access tokens are short-lived and expire daily. This is a
# planned operational concern - see "Known risks" in README.md.
UPSTOX_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# AI explanation layer - Groq
# ---------------------------------------------------------------------------
# Used ONLY to phrase explanations of events the backend has already
# established deterministically. Never used to decide whether an event
# occurred, and never to generate market data.
GROQ_API_KEY=

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
# Local development via docker-compose.yml:
#   postgresql+psycopg://lumen:lumen@localhost:5432/lumen
# Or a hosted Supabase Postgres connection string.
DATABASE_URL=

# Local development via docker-compose.yml:
#   redis://localhost:6379/0
REDIS_URL=

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Base URL of the FastAPI backend, read by the Next.js client.
# Local default: http://localhost:8000
NEXT_PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# Google OAuth client id. The frontend obtains a Google ID token; the BACKEND
# verifies it against Google's JWKS and issues its own session token.
# Supabase Auth is deliberately not used - LUMEN owns identity.
GOOGLE_CLIENT_ID=

# Signing key for LUMEN session tokens. Generate a long random value for any
# non-local deployment; a development default is used when unset.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Protected debug endpoint
# ---------------------------------------------------------------------------
# /api/v1/debug/intelligence is DISABLED (404) unless this is set. When set,
# requests must send it as the X-Lumen-Debug-Token header.
DEBUG_API_TOKEN=

# ---------------------------------------------------------------------------
# Optional tuning (defaults in app/config.py are sensible)
# ---------------------------------------------------------------------------
# GROQ_MODEL=llama-3.3-70b-versatile
# NOTIFY_MIN_SCORE=60                  # High Attention and above only
# OBSERVATION_RETENTION_DAYS=90
# INTELLIGENCE_RECOMPUTE_SECONDS=30    # intelligence recompute throttle
# WS_PRICE_BROADCAST_SECONDS=1.0       # price stream interval
